# Skopiuj do .env i dostosuj. Wszystkie zmienne są opcjonalne.

# Model językowy: atrapa (domyślnie, bez modelu) | lokalny (Ollama) | groq (chmura – tylko dane testowe!)
ASYSTENT_LLM_BACKEND=atrapa
# Embeddingi do wyszukiwania: atrapa | lokalny (Ollama)
ASYSTENT_EMBED_BACKEND=atrapa

# Ollama (tryb lokalny, bez internetu)
ASYSTENT_OLLAMA_URL=http://localhost:11434
ASYSTENT_OLLAMA_MODEL=SpeakLeash/bielik-11b-v2.3-instruct:Q4_K_M
ASYSTENT_OLLAMA_MODEL_EMBED=nomic-embed-text

# Groq (tryb chmurowy, tylko na hackathonie): klucz z https://console.groq.com/keys
AI_API_KEY=
ASYSTENT_GROQ_MODEL=openai/gpt-oss-120b
