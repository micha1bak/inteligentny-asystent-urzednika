# Skopiuj do pliku .env (jest w .gitignore) i uzupełnij klucz.
GROQ_API_KEY=
# Model Groq (domyślnie openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b
# wybrany – streszczenie algorytmu oceny + fragmenty matrycy i archiwum dopasowane do wniosku (~4 tys. tokenów, mieści się w darmowym planie)
# pelny   – cały model oceny prawnej i całe archiwum (~23 tys. tokenów, wymaga płatnego planu Groq)
KONTEKST_PRAWNY=wybrany
# Limit tokenów na minutę planu Groq (darmowy: 8000) – zapytanie jest przycinane, żeby się zmieścić
GROQ_LIMIT_TPM=8000
# Maksymalna długość odpowiedzi modelu (wlicza się do limitu)
GROQ_MAX_TOKENS=2000

# ---------------------------------------------------------------- tryb lokalny (docelowo w urzędzie, bez internetu)
# Dowolny serwer zgodny z API OpenAI, np. Ollama na serwerze urzędu – dane nie opuszczają sieci UMB.
# Gdy LLM_URL wskazuje lokalny serwer, klucz API nie jest wymagany.
# LLM_URL=http://localhost:11434/v1/chat/completions
# LLM_MODEL=SpeakLeash/bielik-11b-v2.3-instruct:Q4_K_M
# Model wizyjny do odczytu skanów (OCR) i rozpoznawania pisma odręcznego:
# OCR_URL=http://localhost:11434/v1/chat/completions
# OCR_MODEL=qwen2.5vl:7b
# Bez żadnego modelu działają: kalendarz, podobne sprawy, propozycja wydziałów (archiwum + zakresy),
# anonimizacja, eksport DOCX/TXT, odczyt Word i PDF z warstwą tekstową.
